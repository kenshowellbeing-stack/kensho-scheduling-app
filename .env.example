# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Calendar sync (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
